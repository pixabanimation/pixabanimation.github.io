# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored — never commit it.

# OpenRouter (used by blog auto-generation in .github/workflows/auto-blog.yml)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Turso database — consumed by tools/*.mjs and database/init.mjs via tools/lib/env.mjs.
# Browser credentials are AES-256-GCM encrypted into js/credentials.js +
# js/credentials-key.js by running:  node tools/encrypt-credentials.mjs
TURSO_URL=libsql://your-database-org.your-db.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.example
